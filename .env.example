# Adobe InDesign API (Firefly Services) — OAuth Server-to-Server credential
# Adobe Developer Console → project → add "InDesign API" → OAuth Server-to-Server
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Copy the exact scopes shown on your credential page
ADOBE_SCOPES=openid,AdobeID,read_organizations,firefly_api,ff_apis
# Optional
ADOBE_ORG_ID=
# Optional: execution URL of an already-registered build script (otherwise auto-registered)
INDESIGN_SCRIPT_URL=

# S3 bucket for job inputs (manifest, images, fonts). Adobe downloads inputs from pre-signed URLs.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder inside the bucket (fonts go in <prefix>/fonts/)
S3_PREFIX=pressflow

# Demo mode only (no DATABASE_URL): long random string the app must send before the server runs
# paid InDesign jobs. In server mode people sign in instead.
PRESSFLOW_API_KEY=

# ---------------------------------------------------------------- team backend (server mode)
# Setting DATABASE_URL turns on sign-in, roles and the shared workspace.
#   postgres://user:pass@host/db   hosted Postgres (Neon, Supabase, RDS…)
#   pglite://.data/pglite          embedded Postgres for local development
DATABASE_URL=
# 32+ random characters (signs session cookies)
AUTH_SECRET=
# Public URL, used for the Google redirect: https://<domain>/api/auth/callback/google
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace domains allowed to sign in
AUTH_ALLOWED_DOMAINS=elets.in
# Always admins (comma-separated). If empty, the first person to sign in becomes admin.
ADMIN_EMAILS=
# Role for new people: contributor (default) or viewer
AUTH_DEFAULT_ROLE=contributor
# Local development only: password-less sign-in on localhost (ignored on Vercel)
AUTH_DEV_LOGIN=
PRESSFLOW_ORG_NAME=Elets Technomedia

# Storage: s3 when S3_BUCKET is set; local (.data/storage) for development
STORAGE_DRIVER=
# Print gates: block below / flag below this effective resolution at placed size
PRINT_MIN_PPI=200
PRINT_TARGET_PPI=300

# Optional: AI Content Preparation suggestions (otherwise built-in rules).
# OpenAI is the default provider; Anthropic is used when OpenAI is not set or fails.
OPENAI_API_KEY=
# Default gpt-4o; any chat model that supports JSON-schema structured outputs
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Pin one provider: openai | anthropic (default: OpenAI first, then Anthropic)
AI_PROVIDER=
# Design Studio: AI recognition of reference pages (page types, sections, text roles) uses the same
# keys. In demo mode (no DATABASE_URL) the route is public but throttled; set 0 to switch it off there.
AI_REFERENCE_DEMO=1
# Optional: protects /api/cron/indesign (daily archive of unwatched builds)
CRON_SECRET=
